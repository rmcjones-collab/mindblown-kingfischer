  {
   "id": "results/strength#2",
   "page": "results/strength",
   "lead": "About 3650 on CCRL",
   "text": "Wikipedia reports that in October 2026 CCRL estimated Stockfish at about 3650 Elo at 40 moves in 15 minutes, the strongest CPU engine on that list.",
