 "synapses": [
  {
   "id": "shared/brain/stockfish-public#1",
   "page": "shared/brain/stockfish-public",
   "lead": "Where the facts come from",
   "text": "Most facts here come from stockfishchess.org, the Stockfish GitHub repositories and the Fishtest wiki; the rest come from Google DeepMind, Science, Chess.com, Lichess, Leela Chess Zero and Wikipedia.",
   "section": "Synapses",
   "links": [
    "self/label",
    "shared/concept/source"
   ],
   "cites": [
    "https://stockfishchess.org/about/",
    "https://github.com/official-stockfish/fishtest",
    "https://deepmind.google/discover/blog/alphazero-shedding-new-light-on-chess-shogi-and-go/",
    "https://en.wikipedia.org/wiki/Stockfish_(chess)"
   ]
  },
  {
   "id": "self/label#1",
   "page": "self/label",
   "lead": "Figures read 2026-11-04",
   "text": "Each number here was read from its cited public page on 4 November 2026 and may change when that page is updated.",
   "section": "Synapses",
   "links": [
    "shared/brain/stockfish-public"
   ],
   "cites": [
    "https://stockfishchess.org/about/",
    "https://en.wikipedia.org/wiki/Stockfish_(chess)"
   ]
  },
  {
   "id": "results/origins#1",
   "page": "results/origins",
   "lead": "A 2008 fork",
   "text": "In November 2008 Marco Costalba forked Tord Romstad's open-source Glaurung 2.1 engine and released Stockfish 1.0.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://stockfishchess.org/about/"
   ]
  },
  {
   "id": "results/origins#2",
   "page": "results/origins",
   "lead": "Three authors, then many",
   "text": "Stockfish was developed by Tord Romstad, Marco Costalba and Joona Kiiski, and is now developed and maintained by the Stockfish community.",
   "section": "Synapses",
   "links": [
    "test/fishtest"
   ],
   "cites": [
    "https://stockfishchess.org/about/"
   ]
  },
  {
   "id": "engine/uci#1",
   "page": "engine/uci",
   "lead": "No graphical interface",
   "text": "Stockfish does not include a graphical interface; chess apps send it positions and read back its moves through the Universal Chess Interface (UCI), a text protocol.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://github.com/official-stockfish/Stockfish",
    "https://official-stockfish.github.io/docs/stockfish-wiki/UCI-Protocol-and-Stockfish-Commands.html"
   ]
  },
  {
   "id": "engine/uci#2",
   "page": "engine/uci",
   "lead": "Playing weaker on purpose",
   "text": "Its UCI_Elo option, used with UCI_LimitStrength, makes Stockfish aim for a set strength between 1320 and 3190 Elo.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://official-stockfish.github.io/docs/stockfish-wiki/UCI-Protocol-and-Stockfish-Commands.html"
   ]
  },
  {
   "id": "engine/search#1",
   "page": "engine/search",
   "lead": "Alpha-beta search",
   "text": "Stockfish scores positions with its evaluation and then uses an alpha-beta search (principal variation search) to find the best move.",
   "section": "Synapses",
   "links": [
    "engine/nnue"
   ],
   "cites": [
    "https://stockfishchess.org/blog/2020/introducing-nnue-evaluation/"
   ]
  },
  {
   "id": "engine/search#2",
   "page": "engine/search",
   "lead": "Millions of positions a second",
   "text": "The Stockfish 18 release notes say that on the highest-end hardware Stockfish can search over 500 million positions per second.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://stockfishchess.org/blog/2026/stockfish-18/"
   ]
  },
  {
   "id": "engine/search#3",
   "page": "engine/search",
   "lead": "Fewer, deeper looks",
   "text": "In DeepMind's 2018 account, AlphaZero searched about 60 thousand positions per second against roughly 60 million for Stockfish.",
   "section": "Synapses",
   "links": [
    "evid/alphazero-2018"
   ],
   "cites": [
    "https://deepmind.google/discover/blog/alphazero-shedding-new-light-on-chess-shogi-and-go/"
   ]
  },
  {
   "id": "engine/nnue#1",
   "page": "engine/nnue",
   "lead": "Borrowed from shogi",
   "text": "NNUE, an efficiently updatable neural network, was first introduced in computer shogi and landed in the Stockfish code on 6 August 2020.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://stockfishchess.org/blog/2020/introducing-nnue-evaluation/"
   ]
  },
  {
   "id": "engine/nnue#2",
   "page": "engine/nnue",
   "lead": "Cheap on a CPU",
   "text": "NNUE runs efficiently on ordinary processors because only parts of the network need updating after a typical move, so Stockfish stayed a CPU-only engine.",
   "section": "Synapses",
   "links": [
    "engine/search"
   ],
   "cites": [
    "https://stockfishchess.org/blog/2020/introducing-nnue-evaluation/",
    "https://stockfishchess.org/blog/2020/stockfish-12/"
   ]
  },
  {
   "id": "engine/nnue#3",
   "page": "engine/nnue",
   "lead": "Ten times more pairs",
   "text": "The Stockfish team reported that Stockfish 12, the first release with NNUE, typically won at least ten times more game pairs than it lost against Stockfish 11.",
   "section": "Synapses",
   "links": [
    "test/elo-claims"
   ],
   "cites": [
    "https://stockfishchess.org/blog/2020/stockfish-12/"
   ]
  },
  {
   "id": "engine/sf19#1",
   "page": "engine/sf19",
   "lead": "New network, one net",
   "text": "Stockfish 19 introduced the SFNNv16 network architecture with new pawn-pair features and retired the secondary small network added in Stockfish 16.1.",
   "section": "Synapses",
   "links": [
    "engine/nnue"
   ],
   "cites": [
    "https://stockfishchess.org/blog/2026/stockfish-19/"
   ]
  },
  {
   "id": "engine/sf19#2",
   "page": "engine/sf19",
   "lead": "Trained on rescored positions",
   "text": "Its training used hundreds of billions of positions, all rescored with a strong Leela Chess Zero network.",
   "section": "Synapses",
   "links": [
    "open/leela-data"
   ],
   "cites": [
    "https://stockfishchess.org/blog/2026/stockfish-19/"
   ]
  },
  {
   "id": "engine/sf19#3",
   "page": "engine/sf19",
   "lead": "Up to 44 Elo",
   "text": "The team reported up to 44 Elo over Stockfish 18 and more than three times as many game pairs won as lost.",
   "section": "Synapses",
   "links": [
    "test/elo-claims"
   ],
   "cites": [
    "https://stockfishchess.org/blog/2026/stockfish-19/"
   ]
  },
  {
   "id": "engine/tablebases#1",
   "page": "engine/tablebases",
   "lead": "Up to seven pieces",
   "text": "Stockfish can read Syzygy endgame tablebases through its SyzygyPath option; its SyzygyProbeLimit setting covers positions with up to seven pieces.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://official-stockfish.github.io/docs/stockfish-wiki/UCI-Protocol-and-Stockfish-Commands.html"
   ]
  },
  {
   "id": "test/fishtest#1",
   "page": "test/fishtest",
   "lead": "A distributed queue",
   "text": "Fishtest is a distributed task queue: developers submit patches, and volunteers' computers play chess games in the background to test them.",
   "section": "Synapses",
   "links": [
    "shared/concept/source"
   ],
   "cites": [
    "https://github.com/official-stockfish/fishtest"
   ]
  },
  {
   "id": "test/fishtest#2",
   "page": "test/fishtest",
   "lead": "20,700 years of CPU time",
   "text": "According to Wikipedia, by October 2026 Fishtest had used more than 20,700 years of CPU time to play over 10.3 billion games.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://en.wikipedia.org/wiki/Stockfish_(chess)"
   ]
  },
  {
   "id": "test/fishtest#3",
   "page": "test/fishtest",
   "lead": "Anyone can lend a computer",
   "text": "The Stockfish site invites people to install the Fishtest worker so their computer runs test games for future versions.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://stockfishchess.org/get-involved/"
   ]
  },
  {
   "id": "test/sprt#1",
   "page": "test/sprt",
   "lead": "Stop when significant",
   "text": "The Fishtest server stops a test once its result is statistically significant, rather than after a fixed number of games.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://github.com/official-stockfish/fishtest"
   ]
  },
  {
   "id": "test/sprt#2",
   "page": "test/sprt",
   "lead": "GSPRT on game pairs",
   "text": "Fishtest uses a generalized sequential probability ratio test and a pentanomial model that scores games in pairs, which it says saves substantial testing resources.",
   "section": "Synapses",
   "links": [
    "test/elo-claims"
   ],
   "cites": [
    "https://github.com/official-stockfish/fishtest/wiki/Fishtest-mathematics"
   ]
  },
  {
   "id": "test/sprt#3",
   "page": "test/sprt",
   "lead": "Checking the testers",
   "text": "A chi-squared test flags workers whose results deviate unusually from the rest.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://github.com/official-stockfish/fishtest/wiki/Fishtest-mathematics"
   ]
  },
  {
   "id": "test/one-idea#1",
   "page": "test/one-idea",
   "lead": "Small and focused",
   "text": "Contributors are asked to keep changes small and to submit one test per idea rather than bundling ideas together.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://github.com/official-stockfish/fishtest/wiki/Creating-my-first-test"
   ]
  },
  {
   "id": "test/one-idea#2",
   "page": "test/one-idea",
   "lead": "Passing is not merging",
   "text": "A patch that passes its tests still needs review, and complex patches need significant benefits to be merged.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://github.com/official-stockfish/fishtest/wiki/Creating-my-first-test"
   ]
  },
  {
   "id": "test/elo-claims#1",
   "page": "test/elo-claims",
   "lead": "Measured against itself",
   "text": "Stockfish release gains are reported in tests against the previous Stockfish version, not against human players.",
   "section": "Synapses",
   "links": [
    "engine/sf19"
   ],
   "cites": [
    "https://stockfishchess.org/blog/2026/stockfish-19/",
    "https://stockfishchess.org/blog/2026/stockfish-18/"
   ]
  },
  {
   "id": "test/elo-claims#2",
   "page": "test/elo-claims",
   "lead": "Calibrated to a list",
   "text": "The UCI_Elo strength setting is calibrated at 120 seconds plus 1 second per move and anchored to the CCRL 40/4 rating list.",
   "section": "Synapses",
   "links": [
    "engine/uci"
   ],
   "cites": [
    "https://official-stockfish.github.io/docs/stockfish-wiki/UCI-Protocol-and-Stockfish-Commands.html"
   ]
  },
  {
   "id": "results/tcec#1",
   "page": "results/tcec",
   "lead": "Nineteen titles",
   "text": "According to Wikipedia, Stockfish is the reigning TCEC champion and has won the competition 19 times.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://en.wikipedia.org/wiki/Stockfish_(chess)"
   ]
  },
  {
   "id": "results/tcec#2",
   "page": "results/tcec",
   "lead": "Once missed",
   "text": "Season 10 was the only season since 2013 in which Stockfish failed to reach the superfinal; it lost no games but did not score enough wins against lower-rated engines.",
   "section": "Synapses",
   "links": [],
   "cites": [
    "https://en.wikipedia.org/wiki/Stockfish_(chess)"
   ]
  },
  {
   "id": "results/leela#1",
   "page": "results/leela",
   "lead": "Learned from self-play",
   "text": "Leela Chess Zero is an open-source engine inspired by DeepMind's AlphaZero, with a neural network that learned chess through self-play.",
